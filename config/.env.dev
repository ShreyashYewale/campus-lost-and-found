# Development Environment
# Used during local development

# API
API_BASE_URL=http://localhost:4000/graphql
API_TIMEOUT_SECONDS=30

# Google OAuth
GOOGLE_CLIENT_ID_WEB=YOUR_DEV_GOOGLE_CLIENT_ID_WEB
GOOGLE_CLIENT_ID_IOS=YOUR_DEV_GOOGLE_CLIENT_ID_IOS
GOOGLE_CLIENT_ID_ANDROID=YOUR_DEV_GOOGLE_CLIENT_ID_ANDROID

# Features
ENABLE_DEBUG=true
ENABLE_ML_MATCHING=true
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=false

# Logging
LOG_LEVEL=debug

# App
APP_NAME=Campus Lost & Found (Dev)
BUILD_TYPE=debug
