# Staging Environment
# Used for testing before production release

# API
API_BASE_URL=https://staging-api.campuslostfound.com/graphql
API_TIMEOUT_SECONDS=30

# Google OAuth
GOOGLE_CLIENT_ID_WEB=YOUR_STAGING_GOOGLE_CLIENT_ID_WEB
GOOGLE_CLIENT_ID_IOS=YOUR_STAGING_GOOGLE_CLIENT_ID_IOS
GOOGLE_CLIENT_ID_ANDROID=YOUR_STAGING_GOOGLE_CLIENT_ID_ANDROID

# Features
ENABLE_DEBUG=false
ENABLE_ML_MATCHING=true
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=true

# Logging
LOG_LEVEL=info

# App
APP_NAME=Campus Lost & Found (Staging)
BUILD_TYPE=profile
