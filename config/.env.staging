# Staging Environment
# Used for testing before production release

# API
API_BASE_URL=https://staging-api.campuslostfound.com/api/graphql
API_TIMEOUT_SECONDS=30

# Features
ENABLE_DEBUG=false
ENABLE_ML_MATCHING=true
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=true

# Logging
LOG_LEVEL=info

# App
APP_NAME=Campus Lost & Found (Staging)
BUILD_TYPE=profile
