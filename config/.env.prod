# Production Environment
# Live environment for end users

# API
API_BASE_URL=https://api.campuslostfound.com/graphql
API_TIMEOUT_SECONDS=30

# Google OAuth
GOOGLE_CLIENT_ID_WEB=YOUR_PROD_GOOGLE_CLIENT_ID_WEB
GOOGLE_CLIENT_ID_IOS=YOUR_PROD_GOOGLE_CLIENT_ID_IOS
GOOGLE_CLIENT_ID_ANDROID=YOUR_PROD_GOOGLE_CLIENT_ID_ANDROID

# Features
ENABLE_DEBUG=false
ENABLE_ML_MATCHING=true
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=true

# Logging
LOG_LEVEL=error

# App
APP_NAME=Campus Lost & Found
BUILD_TYPE=release
