// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource postgresql {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  name          String         @default("")
  email         String         @unique @default("")
  googleId      String         @unique @default("")
  items         Item[]         @relation("Item_postedBy")
  claims        Claim[]        @relation("Claim_claimant")
  notifications Notification[] @relation("Notification_recipient")
  createdAt     DateTime?      @default(now())
}

model Item {
  id                            String         @id @default(cuid())
  title                         String         @default("")
  description                   String         @default("")
  type                          String
  category                      String
  location                      String
  photo_id                      String?
  photo_filesize                Int?
  photo_width                   Int?
  photo_height                  Int?
  photo_extension               String?
  status                        String?        @default("open")
  dateOccurred                  DateTime?
  postedBy                      User?          @relation("Item_postedBy", fields: [postedById], references: [id])
  postedById                    String?        @map("postedBy")
  claims                        Claim[]        @relation("Claim_item")
  createdAt                     DateTime?      @default(now())
  from_Notification_relatedItem Notification[] @relation("Notification_relatedItem")

  @@index([postedById])
}

model Claim {
  id         String    @id @default(cuid())
  item       Item?     @relation("Claim_item", fields: [itemId], references: [id])
  itemId     String?   @map("item")
  claimant   User?     @relation("Claim_claimant", fields: [claimantId], references: [id])
  claimantId String?   @map("claimant")
  message    String    @default("")
  status     String?   @default("pending")
  createdAt  DateTime? @default(now())

  @@index([itemId])
  @@index([claimantId])
}

model Notification {
  id            String    @id @default(cuid())
  recipient     User?     @relation("Notification_recipient", fields: [recipientId], references: [id])
  recipientId   String?   @map("recipient")
  type          String?
  message       String    @default("")
  relatedItem   Item?     @relation("Notification_relatedItem", fields: [relatedItemId], references: [id])
  relatedItemId String?   @map("relatedItem")
  isRead        Boolean   @default(false)
  createdAt     DateTime? @default(now())

  @@index([recipientId])
  @@index([relatedItemId])
}
